# Cloudinary Configuration
# Add this to your .env.local file (frontend)

# Cloudinary Cloud Name - Replace with your actual cloud name
VITE_CLOUDINARY_CLOUD_NAME=bhumi

# Optional: Cloudinary Upload Preset (if you want to allow client-side uploads)
# VITE_CLOUDINARY_UPLOAD_PRESET=your_upload_preset

# Optional: Enable image optimization features
VITE_ENABLE_IMAGE_LAZY_LOAD=true
VITE_ENABLE_IMAGE_OPTIMIZATION=true
VITE_IMAGE_BLUR_UP_PLACEHOLDER=false
